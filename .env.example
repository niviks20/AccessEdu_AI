# Copy this file to .env and fill in real values. Never commit or share .env.

# Required for the AI Academic Bot (Learn / Notes / Practice)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: powers the free-form tutor chat at /api/academic-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Flask session security — set a long random string in production
FLASK_SECRET_KEY=change-me-to-a-random-string

# Admin login (change the default before deploying)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
